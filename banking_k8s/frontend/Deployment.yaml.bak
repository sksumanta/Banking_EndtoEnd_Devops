
#	Deployment.yaml
#=================================

apiVersion: apps/v1
kind: Deployment
metadata:
  name: frontend
spec:
  replicas: 2
  selector:
    matchLabels:
      app: frontend
  template:
    metadata:
      labels:
        app: frontend
    spec:
      containers:
        - name: frontend
          image: yourdockerhub/frontend:latest
          ports:
            - containerPort: 80
          env:
            - name: CUSTOMER_CARE_URL
              value: http://customer-care
            - name: DEPOSIT_URL
              value: http://deposit
            - name: WITHDRAW_URL
              value: http://withdraw
          livenessProbe:
            httpGet:
              path: /health
              port: 80
            initialDelaySeconds: 15
            periodSeconds: 10